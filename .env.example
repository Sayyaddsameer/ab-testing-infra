# Environment Variables
# Copy this file to .env before running docker-compose up.
#   cp .env.example .env

# AWS region where all resources will be created
AWS_DEFAULT_REGION=us-east-1

# LocalStack accepts any non-empty credentials, so these are just placeholders
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Which AWS services LocalStack should spin up
SERVICES=ec2,elbv2,autoscaling,iam,s3,sts

# Flip to 1 if you need verbose LocalStack output for debugging
DEBUG=0

# Only needed if you're using LocalStack Pro features
# LOCALSTACK_AUTH_TOKEN=
